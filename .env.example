# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL + PostGIS Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=last_mile_delivery
DATABASE_URL=postgres://postgres:your_db_password@localhost:5432/last_mile_delivery

# JWT Authentication
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Used by seed script)
ADMIN_EMAIL=admin@delivery.com
ADMIN_PASSWORD=password123

# Email Notification (SMTP / Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=notifications@lastmiledelivery.com

# SMS Notification (Console Mock by default)
SMS_PROVIDER=CONSOLE
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

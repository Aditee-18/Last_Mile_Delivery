# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL + PostGIS Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=last_mile_delivery
DATABASE_URL=postgres://postgres:postgres@localhost:5432/last_mile_delivery

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_last_mile_delivery_2026
JWT_EXPIRES_IN=7d

# Email Notification (SMTP / Nodemailer)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
FROM_EMAIL=notifications@lastmiledelivery.com

# SMS Notification (Optional / Console Mock by default)
SMS_PROVIDER=CONSOLE
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
